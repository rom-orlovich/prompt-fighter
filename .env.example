# Only needed for the OpenRouter fighter brain (`--brain openrouter`), used by live
# mode's CLI (`npm run fight`) and its remote client (`--connect`). The demo, the
# bundled transcripts, and live mode's default local brain all require no key at all.
#
# Copy to .env and fill in. .env is gitignored — never commit a real key.
OPENROUTER_API_KEY=

# Optional: which OpenRouter model each fighter's brain calls. Defaults to
# "openrouter/auto" if unset.
OPENROUTER_MODEL=
